printf 'import requests\nimport time\n\nwhile True:\n    try:\n        response = requests.get("http://app:5000/")\n        print("[OK] status=" + str(response.status_code) + " body=" + response.text, flush=True)\n    except Exception as e:\n        print("[ERROR] " + str(e), flush=True)\n    time.sleep(5)\n' > ~/docker-hw/client/client.py
